{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeSeam Dev",
  "version": "0.4.0",
  "identifier": "app.codeseam.desktop.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeSeam · P1 开发版",
        "width": 900,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/zsw.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/zsw.ico",
        "uninstallerIcon": "icons/zsw.ico"
      }
    }
  },
  "plugins": {}
}
