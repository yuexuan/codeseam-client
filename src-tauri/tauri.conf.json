{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeSeam",
  "version": "0.5.1",
  "identifier": "app.codeseam.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeSeam",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "resources/MIHOMO-LICENSE": "MIHOMO-LICENSE",
      "../PRODUCT-NOTICE.txt": "PRODUCT-NOTICE.txt"
    }
  },
  "plugins": {}
}
