{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeSeam",
  "version": "0.5.0",
  "identifier": "app.codeseam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeSeam",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/codeseam.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/codeseam.ico",
        "uninstallerIcon": "icons/codeseam.ico",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../PRODUCT-NOTICE.txt": "PRODUCT-NOTICE.txt"
    }
  },
  "plugins": {}
}
