{
  "name": "codeseam",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "npm run lint && npm run styles:check && npm run boundaries && npm run build",
    "lint": "eslint src scripts/*.mjs",
    "styles:check": "stylelint \"src/**/*.css\"",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "boundaries": "node scripts/check-boundaries.mjs",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --nocapture",
    "bindings:check": "node scripts/check-bindings.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.62.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.4"
  }
}
